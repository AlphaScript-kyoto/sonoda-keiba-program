# コピー: cp .env.example .env して値を入れる
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_USER_ID=your_line_user_id_here
# Team predict push (comma-separated user IDs; collect via line_webhook_server.py)
LINE_TEAM_USER_IDS=
# T-10 LINE netkeiba marks link (default on; set 0 to disable)
# NETKEIBA_MARKS_LINK_ENABLED=0

# Discord webhooks
# NOTE:
# - Put real webhook URLs in .env (not .env.example).
# - If a category-specific webhook is empty, DISCORD_WEBHOOK_URL is used as fallback.
# - Recommended channel split:
#   t10_predict = T-10本文 / s_plus_buy = S+買い目 / s_plus_payback = S+払戻
#   p6_buy = P6買い目 / p6_payback = P6払戻 / p6_pause = P6見送り通知
#   watch_alert = 障害アラート / watch_broadcast = 開始などの運用連絡
# Base fallback webhook (used when category-specific webhook is not set)
DISCORD_WEBHOOK_URL=
# Optional bot display name
DISCORD_BOT_NAME=Sonoda Bot
# Category routing (fill only channels you want to split)
# T-10予想本文（各レース10分前）
DISCORD_WEBHOOK_T10_PREDICT=
# 期待値S+の買い目通知
DISCORD_WEBHOOK_S_PLUS_BUY=
# 期待値S+の払戻結果
DISCORD_WEBHOOK_S_PLUS_PAYBACK=
# P6（荒×High）買い目通知
DISCORD_WEBHOOK_P6_BUY=
# P6（荒×High）払戻結果
DISCORD_WEBHOOK_P6_PAYBACK=
# P6見送り/休止ゲート通知
DISCORD_WEBHOOK_P6_PAUSE=
# 障害・失敗アラート（送信失敗、監視異常、監視完了など）
DISCORD_WEBHOOK_WATCH_ALERT=
# 監視開始などの運用ブロードキャスト
DISCORD_WEBHOOK_WATCH_BROADCAST=
